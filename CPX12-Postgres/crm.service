[Unit]
Description=CRM Dashboard (crm_serve.py)
After=network.target

[Service]
Type=simple
User=crmapp
Group=crmapp
WorkingDirectory=/opt/crm-repo/CPX12-Postgres
ExecStart=/usr/bin/python3 /opt/crm-repo/CPX12-Postgres/crm_serve.py
Restart=on-failure
RestartSec=3
Environment=CRM_HOST=127.0.0.1
Environment=CRM_PORT=8080

[Install]
WantedBy=multi-user.target
