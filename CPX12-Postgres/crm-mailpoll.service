[Unit]
Description=CRM Mail-Poller (mail_poller.py)
After=network.target crm.service

[Service]
Type=simple
User=crmapp
Group=crmapp
WorkingDirectory=/opt/crm
ExecStart=/usr/bin/python3 /opt/crm/mail_poller.py
Restart=on-failure
RestartSec=10
Environment=CRM_PORT=8080

[Install]
WantedBy=multi-user.target
